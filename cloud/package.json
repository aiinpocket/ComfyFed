{
  "name": "comfyfed-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --skip-comfy && wrangler dev",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "ci-build": "npm ci && npm run build",
    "predeploy": "node scripts/check-assets.mjs",
    "deploy": "wrangler d1 migrations apply comfyfed --remote && wrangler deploy",
    "seed-official": "node scripts/seed-official.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "^20.19.43",
    "typescript": "5.7.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "hono": "4.13.7"
  }
}
