{
  "id": "chroma-t2i",
  "title": {
    "zh-TW": "Chroma 文生圖（預設）",
    "en": "Chroma text-to-image (default)"
  },
  "description": {
    "zh-TW": "用 Chroma1-HD 依文字提示產生一張圖；權重本身不做內容審查。需要 Chroma1-HD-fp8mixed、t5xxl_fp16 與 ae 三個模型，缺的會自動下載。",
    "en": "Generate one image from a text prompt with Chroma1-HD, an uncensored Flux-architecture checkpoint. Needs the Chroma1-HD-fp8mixed, t5xxl_fp16 and ae models; a missing one is fetched automatically."
  },
  "order": 10,
  "nsfw_ok": true,
  "params": [
    {
      "name": "prompt",
      "type": "string",
      "required": true,
      "description": {
        "zh-TW": "畫面描述（英文效果最好）",
        "en": "What to draw (English works best)"
      }
    },
    {
      "name": "negative",
      "type": "string",
      "default": "This low quality greyscale unfinished sketch is inaccurate and flawed. The image is very blurred and lacks detail with excessive chromatic aberrations and artifacts. The image is overly saturated with excessive bloom. It has a toony aesthetic with bold outlines and flat colors. ",
      "description": {
        "zh-TW": "負向提示（預設為官方範本的句子）",
        "en": "Negative prompt (defaults to the official template's sentence)"
      }
    },
    {
      "name": "width",
      "type": "integer",
      "default": 1024,
      "min": 256,
      "max": 2048,
      "step": 16,
      "description": {
        "zh-TW": "寬度，16 的倍數",
        "en": "Width, a multiple of 16"
      }
    },
    {
      "name": "height",
      "type": "integer",
      "default": 1024,
      "min": 256,
      "max": 2048,
      "step": 16,
      "description": {
        "zh-TW": "高度，16 的倍數",
        "en": "Height, a multiple of 16"
      }
    },
    {
      "name": "steps",
      "type": "integer",
      "default": 26,
      "min": 1,
      "max": 60,
      "description": {
        "zh-TW": "取樣步數",
        "en": "Sampling steps"
      }
    },
    {
      "name": "cfg",
      "type": "number",
      "default": 3.5,
      "min": 0,
      "max": 20,
      "description": {
        "zh-TW": "CFG 強度",
        "en": "CFG scale"
      }
    },
    {
      "name": "seed",
      "type": "integer",
      "default": -1,
      "min": -1,
      "max": 4294967295,
      "description": {
        "zh-TW": "-1 = 隨機",
        "en": "-1 = random"
      }
    }
  ],
  "required_models": [
    "Chroma1-HD-fp8mixed.safetensors",
    "t5xxl_fp16.safetensors",
    "ae.safetensors"
  ],
  "model_sources": [
    {
      "name": "Chroma1-HD-fp8mixed.safetensors",
      "directory": "diffusion_models",
      "url": "https://huggingface.co/Comfy-Org/Chroma1-HD_repackaged/resolve/main/split_files/diffusion_models/Chroma1-HD-fp8mixed.safetensors"
    }
  ],
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "Chroma1-HD-fp8mixed.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "t5xxl_fp16.safetensors",
        "type": "chroma",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ae.safetensors"
      }
    },
    "4": {
      "class_type": "T5TokenizerOptions",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "min_padding": 1,
        "min_length": 0
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": {
          "$param": "prompt"
        },
        "clip": [
          "4",
          0
        ]
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": {
          "$param": "negative"
        },
        "clip": [
          "4",
          0
        ]
      }
    },
    "7": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": 1
      }
    },
    "8": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "7",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "cfg": {
          "$param": "cfg"
        }
      }
    },
    "9": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "10": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "7",
          0
        ],
        "scheduler": "beta",
        "steps": {
          "$param": "steps"
        },
        "denoise": 1
      }
    },
    "11": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": {
          "$param": "seed"
        }
      }
    },
    "12": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": {
          "$param": "width"
        },
        "height": {
          "$param": "height"
        },
        "batch_size": 1
      }
    },
    "13": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "11",
          0
        ],
        "guider": [
          "8",
          0
        ],
        "sampler": [
          "9",
          0
        ],
        "sigmas": [
          "10",
          0
        ],
        "latent_image": [
          "12",
          0
        ]
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "13",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "15": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "14",
          0
        ],
        "filename_prefix": "comfyfed_recipe"
      }
    }
  }
}
