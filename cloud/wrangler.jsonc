{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comfyfed-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MODE": "cloud",
    // First-run /api/setup gate (Task 4). This plaintext dev value is fine
    // for local `wrangler dev` / vitest only -- a real deployment must
    // override it with `wrangler secret put SETUP_TOKEN` (secrets shadow
    // `vars` of the same name) rather than committing the real token here.
    "SETUP_TOKEN": "dev-setup-token-changeme"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comfyfed",
      "database_id": "TBD-set-at-deploy",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Hub"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORE",
      "bucket_name": "comfyfed-store"
    }
  ],
  "assets": {
    "directory": "assets",
    "binding": "ASSETS",
    "run_worker_first": ["/comfy/*", "/api/*"],
    "not_found_handling": "single-page-application"
  }
}
